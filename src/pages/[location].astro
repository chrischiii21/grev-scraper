---
import PageLayout from "~/layouts/PageLayout.astro";
import SectionRenderer from "~/components/SectionRenderer.astro";
import { getLocations, localizeData } from "~/utils/site";
import {
  breadcrumbSchema,
  faqPageSchema,
  locationLocalBusinessSchema,
} from "~/utils/schema";

import arvadaData from "~/data/locations/arvada.json";
import auroraData from "~/data/locations/aurora.json";
import centennialData from "~/data/locations/centennial.json";
import lakewoodData from "~/data/locations/lakewood.json";

const locationDataMap: Record<string, any> = {
  "arvada": arvadaData,
  "aurora": auroraData,
  "centennial": centennialData,
  "lakewood": lakewoodData,
};

export function getStaticPaths() {
  const locations = getLocations();
  return locations.map(loc => ({
    params: { location: loc.slug },
  }));
}

const { location } = Astro.params;

const locationName =
  getLocations().find((l) => l.slug === location)?.name || (location as string);

// Replace {location} with the city name across the whole data tree.
// ({city}, {state}, etc. are handled globally by localizeData in SectionRenderer.)
function localizeLocation<T>(data: T): T {
  if (typeof data === "string") return data.replaceAll("{location}", locationName) as T;
  if (Array.isArray(data)) return data.map((item) => localizeLocation(item)) as T;
  if (data !== null && typeof data === "object") {
    const result: Record<string, unknown> = {};
    for (const [key, value] of Object.entries(data)) {
      result[key] = localizeLocation(value);
    }
    return result as T;
  }
  return data;
}

const locationContent = localizeLocation(locationDataMap[location!]);

const sections = [...(locationContent.sections || [])].sort(
  (a: any, b: any) => (a.order || 0) - (b.order || 0)
);

// NewsletterCTA sections are excluded here; PageLayout renders the global final CTA
const mainSections = sections.filter((s: any) => s.section !== "NewsletterCTA");

const metadata = {
  title: locationContent.metadata?.title || locationContent.title,
  description: locationContent.metadata?.description || locationContent.description,
  keywords: locationContent.metadata?.keywords || "",
  canonical: `${Astro.url.origin}/${location}`,
  noindex: false,
  nofollow: false,
};

const origin = Astro.url.origin;
const pageUrl = `${origin}/${location}`;

const faqSection = sections.find((s: any) => s.section === "FAQs");
const schemas: Array<Record<string, unknown>> = [
  locationLocalBusinessSchema(origin, pageUrl, locationName),
  breadcrumbSchema(origin, [
    { name: "Home", path: "/" },
    { name: locationName, path: `/${location}` },
  ]),
];
const faqSchema = faqSection ? faqPageSchema(localizeData(faqSection.faqs)) : null;
if (faqSchema) schemas.push(faqSchema);
---

<PageLayout metadata={metadata} hideMap={true} schemas={schemas}>
  {mainSections.map((section: any) => <SectionRenderer section={section} />)}
</PageLayout>
