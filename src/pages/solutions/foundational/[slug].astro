---
import PageLayout from "~/layouts/PageLayout.astro";
import CTANewsletter from "~/components/widgets/CTANewsletter.astro";
import SectionRenderer from "~/components/SectionRenderer.astro";
import { getPageTitle } from "~/utils/config";
import {
  breadcrumbSchema,
  faqPageSchema,
  serviceSchema,
} from "~/utils/schema";

import websiteDesignData from "~/data/solutions/foundational/website-design.json";
import googleBusinessProfileData from "~/data/solutions/foundational/google-business-profile.json";
import socialMediaManagementData from "~/data/solutions/foundational/social-media-management.json";
import designServicesData from "~/data/solutions/foundational/design-services.json";

const dataMap: Record<string, any> = {
  "website-design": websiteDesignData,
  "google-business-profile": googleBusinessProfileData,
  "social-media-management": socialMediaManagementData,
  "design-services": designServicesData,
};

export function getStaticPaths() {
  return [
    { params: { slug: "website-design" } },
    { params: { slug: "google-business-profile" } },
    { params: { slug: "social-media-management" } },
    { params: { slug: "design-services" } },
  ];
}

const { slug } = Astro.params;
const entry = dataMap[slug!];

const sections = [...(entry.sections || [])].sort(
  (a: any, b: any) => (a.order || 0) - (b.order || 0)
);

const metadata = {
  title: entry.metadata?.title || getPageTitle(entry.title),
  description: entry.metadata?.description || entry.description,
  keywords: entry.metadata?.keywords || "",
  canonical: `${Astro.url.origin}/solutions/foundational/${slug}`,
  noindex: false,
  nofollow: false,
};

const origin = Astro.url.origin;
const pageUrl = `${origin}/solutions/foundational/${slug}`;
const faqSection = sections.find((s: any) => s.section === "FAQs");
const heroSection = sections.find((s: any) => s.section === "Hero");
const schemas: Array<Record<string, unknown>> = [
  serviceSchema(origin, pageUrl, {
    name: entry.title,
    description: entry.description,
    image: heroSection?.image || heroSection?.backgroundImage,
    serviceType: "Foundational Services",
  }),
  breadcrumbSchema(origin, [
    { name: "Home", path: "/" },
    { name: "Solutions", path: "/solutions" },
    { name: "Foundational", path: "/solutions/foundational" },
    { name: entry.title, path: `/solutions/foundational/${slug}` },
  ]),
];
const faqSchema = faqSection ? faqPageSchema(faqSection.faqs) : null;
if (faqSchema) schemas.push(faqSchema);
---

<PageLayout metadata={metadata} schemas={schemas}>
  {sections.map((section: any) => <SectionRenderer section={section} />)}

  <CTANewsletter
    slot="after-map"
    title="Ready to Get Started?"
    description="Join hundreds of businesses who have transformed their online presence with our services. Get started today and see the difference."
    buttonText="Get In Touch"
    backgroundImage="/images/San-Antonio-Texas-Banner.webp"
  />
</PageLayout>
