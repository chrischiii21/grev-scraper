---
import type { MetaData } from "~/types";
import Header from "~/components/widgets/Header.astro";
import Footer from "~/components/widgets/Footer.astro";
import { siteConfig, localizeData } from "~/utils/site";
import {
  organizationSchema,
  localBusinessSchema,
  websiteSchema,
} from "~/utils/schema";
import "~/styles/global.css";

export interface Props {
  metadata?: MetaData;
  schemas?: Array<Record<string, unknown>>;
}

const { metadata = {}, schemas = [] } = Astro.props;
const {
  title = siteConfig.seo.defaultTitle,
  description,
  image,
  canonical,
  noindex,
  keywords,
} = localizeData(metadata) as MetaData & { keywords?: string };

const resolvedTitle = title;
const resolvedDescription = description;
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const resolvedCanonical = canonical || `${Astro.url.origin}${rawPath}`;
const shouldNoIndex = noindex === true;

const origin = Astro.url.origin;
const allSchemas = [
  organizationSchema(origin),
  localBusinessSchema(origin),
  websiteSchema(origin),
  ...schemas,
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{resolvedTitle}</title>
    {resolvedDescription && <meta name="description" content={resolvedDescription} />}
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={resolvedCanonical} />
    <link rel="icon" type="image/svg+xml" href="/images/vertical-flow-favicon.svg" />

    {shouldNoIndex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}

    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link rel="preload" href={siteConfig.logo.srcAvif} as="image" type="image/avif" fetchpriority="high" />
    <link rel="preload" href={siteConfig.logo.srcWebp} as="image" type="image/webp" fetchpriority="high" />
    <link rel="preload" href="/fonts/DMSans-VariableFont_opsz,wght.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    <meta name="theme-color" content={siteConfig.colors.primary} />

    <style set:html={`
      :root {
        --brand-primary: ${siteConfig.colors.primary};
        --brand-secondary: ${siteConfig.colors.secondary};
        --brand-tertiary: ${siteConfig.colors.tertiary};
        --brand-quaternary: ${siteConfig.colors.quaternary};
        --brand-dark: ${siteConfig.colors.dark};
        --brand-light: ${siteConfig.colors.light};
      }
    `} />

    <meta property="og:title" content={resolvedTitle} />
    {resolvedDescription && <meta property="og:description" content={resolvedDescription} />}
    {image && <meta property="og:image" content={image} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    {resolvedDescription && <meta name="twitter:description" content={resolvedDescription} />}

    {allSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

  </head>
  <body class="antialiased text-gray-900 bg-white">
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
