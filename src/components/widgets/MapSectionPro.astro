---
import { siteConfig } from '~/utils/site';

interface Props {
  title?: string;
  description?: string;
  locations?: string[];
  mapUrl?: string;
  viewMode?: "half" | "full";
}

const { 
  title = "Our Locations", 
  description, 
  locations = [], 
  mapUrl = siteConfig.map.embedUrl,
  viewMode = "half" 
} = Astro.props;
---

<section class="relative py-16 md:py-20 lg:py-24 bg-white overflow-hidden">
  <div class="container mx-auto px-4">
    <div class="max-w-[1240px] mx-auto">
      
      <!-- Header -->
      {(title || description) && (
        <div class="text-center mb-12 max-w-3xl mx-auto">
          {title && (
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--brand-dark)] leading-tight mb-6">
              {title}
            </h2>
          )}
          {description && (
            <p class="text-base md:text-lg text-gray-600 leading-relaxed" set:html={description} />
          )}
        </div>
      )}

      <!-- Map and Locations Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-stretch">
        
        <!-- Map Container -->
        <div class="order-2 lg:order-1 flex">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-gray-200 w-full">
            <iframe 
              class="w-full h-[400px] lg:h-full lg:min-h-[600px]" 
              src={mapUrl}
              style="border:0;" 
              allowfullscreen="" 
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Location Map"
            />
          </div>
        </div>

        <!-- Locations List -->
        <div class="order-1 lg:order-2 flex">
          <div class="bg-gradient-to-br from-[var(--brand-dark)] to-[var(--brand-dark)] rounded-2xl p-8 lg:p-10 shadow-xl w-full flex flex-col">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-12 h-12 bg-[var(--brand-tertiary)]/20 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-[var(--brand-tertiary)]" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-white">
                Our Network Locations
              </h3>
            </div>
            
            <p class="text-white/80 text-sm mb-8 leading-relaxed">
              We're proud to serve businesses across multiple vibrant neighborhoods and communities.
            </p>

            {locations && locations.length > 0 && (
              <ul class="space-y-4 flex-grow">
                {locations.map((location) => (
                  <li class="flex items-start gap-3 group">
                    <span class="inline-flex items-center justify-center h-6 w-6 bg-[var(--brand-tertiary)]/20 text-[var(--brand-tertiary)] rounded-full flex-shrink-0 mt-0.5 group-hover:bg-[var(--brand-tertiary)] group-hover:text-white transition-all duration-300">
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                      </svg>
                    </span>
                    <span class="font-medium text-white text-sm group-hover:text-[var(--brand-tertiary)] transition-colors duration-300">
                      {location}
                    </span>
                  </li>
                ))}
              </ul>
            )}

            <!-- CTA -->
            <div class="mt-auto pt-8 border-white/10">
              <a 
                href="/contact-us" 
                class="group inline-flex items-center gap-3 w-full justify-center py-3.5 px-6 text-base font-bold text-[var(--brand-dark)] bg-white rounded-full transition-all duration-300 hover:bg-[var(--brand-tertiary)] hover:text-white hover:shadow-lg"
              >
                <span>Get In Touch</span>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
