---
import { Image } from 'astro:assets';

interface DesignSkill {
  title: string;
  description?: string;
  image?: string;
  background?: string;
  portrait?: boolean;
}

interface Props {
  title?: string;
  description?: string;
  skills: DesignSkill[];
}

const { title, description, skills = [] } = Astro.props;
---

<section class="py-16 md:py-24 bg-white">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
    {(title || description) && (
      <div class="text-center max-w-3xl mx-auto mb-12">
        {title && <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-4 text-primary-dark">{title}</h2>}
        {description && <p class="text-base sm:text-lg md:text-xl text-gray-600 mb-8" set:html={description} />}
      </div>
    )}

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-start">
      {skills.map((skill) => (
        (skill.title === "Flyers" || skill.title === "Product Packaging") ? (
          <div class="group relative aspect-[4/3] rounded-lg overflow-hidden cursor-pointer shadow-lg hover:shadow-2xl transition-all duration-700 ease-out bg-white">
            <div class="absolute inset-0 flex items-center justify-center">
              <img
                src={skill.image || ''}
                alt={skill.title}
                class="design-skill-img w-full h-full object-contain"
                loading="lazy"
              />
            </div>
            <div class="absolute inset-0 z-10 bg-slate-900/40 group-hover:bg-slate-900/80 group-hover:backdrop-blur-sm transition-all duration-700 ease-in-out"></div>
            <div class="absolute inset-0 z-20 flex flex-col justify-end p-6 text-white">
              <h3 class="text-xl md:text-2xl font-bold mb-2 transition-all duration-700 ease-out transform group-hover:translate-y-[-4px]">
                {skill.title}
              </h3>
              {skill.description && (
                <div class="overflow-hidden transition-all duration-700 ease-out max-h-0 group-hover:max-h-48 transform">
                  <p class="text-sm leading-relaxed opacity-0 group-hover:opacity-100 transition-all duration-700 delay-150 ease-out transform translate-y-2 group-hover:translate-y-0">
                    {skill.description}
                  </p>
                </div>
              )}
            </div>
          </div>
        ) : (
          <div class="group relative aspect-[4/3] rounded-lg overflow-hidden cursor-pointer shadow-lg hover:shadow-2xl transition-all duration-700 ease-out">
            <div class="absolute inset-0 w-full h-full z-0">
              <Image
                src={skill.image || '/images/graphic-design'}
                alt={skill.title}
                width={800}
                height={600}
                class="design-skill-img w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
                loading="lazy"
              />
            </div>
            <div class="absolute inset-0 z-10 bg-slate-900/40 group-hover:bg-slate-900/80 group-hover:backdrop-blur-sm transition-all duration-700 ease-in-out"></div>
            <div class="absolute inset-0 z-20 flex flex-col justify-end p-6 text-white">
              <h3 class="text-xl md:text-2xl font-bold mb-2 transition-all duration-700 ease-out transform group-hover:translate-y-[-4px]">
                {skill.title}
              </h3>
              {skill.description && (
                <div class="overflow-hidden transition-all duration-700 ease-out max-h-0 group-hover:max-h-48 transform">
                  <p class="text-sm leading-relaxed opacity-0 group-hover:opacity-100 transition-all duration-700 delay-150 ease-out transform translate-y-2 group-hover:translate-y-0">
                    {skill.description}
                  </p>
                </div>
              )}
            </div>
          </div>
        )
      ))}
    </div>
  </div>
</section>
