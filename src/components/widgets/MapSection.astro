---
import { getMapDefaults, siteConfig } from "~/utils/site";

interface Props {
  title?: string;
  description?: string;
  locations?: string[];
  mapUrl?: string;
  viewMode?: "full" | "half";
}

const {
  title = `Serving ${siteConfig.location.city} and Surrounding Areas`,
  description,
  mapUrl = getMapDefaults().embedUrl,
} = Astro.props;
---

<section class="relative py-16 md:py-20 bg-light">
  <div class="container px-4 sm:px-6 lg:px-8 mx-auto">
    <div class="max-w-[1240px] mx-auto">
      <!-- Header -->
      <div class="max-w-2xl mb-10">
        {title && (
          <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4 text-balance">
            {title}
          </h2>
        )}

        {description && (
          <p class="text-base md:text-lg text-gray-700 leading-relaxed" set:html={description} />
        )}
      </div>

      <!-- Map -->
      <div class="relative min-h-[340px] sm:min-h-[420px] lg:min-h-[520px] rounded-2xl overflow-hidden shadow-lg">
        <iframe
          class="map-iframe absolute inset-0 w-full h-full"
          src={mapUrl}
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Map of ${siteConfig.map.center}`}
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* On mobile, render the iframe at 520px (wide enough for Google's map
     header to fit on one line) and scale it down to fit the container. */
  @media (max-width: 639px) {
    .map-iframe {
      width: 520px;
      height: calc(100% / 0.72);
      transform: scale(0.72);
      transform-origin: top left;
    }
  }
</style>
