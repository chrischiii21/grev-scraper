---
import reviewsData from "~/data/settings/reviews.json";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  ctaText?: string;
  maxReviews?: number;
}

const {
  eyebrow = "Trusted by Local Businesses",
  title = "What Our Clients Say",
  description = "Don't just take our word for it. See why San Antonio businesses trust Alamo Media Network for their marketing needs.",
  ctaText = "View All Google Reviews",
  maxReviews = 5,
} = Astro.props;

const { reviewsUrl, reviews: allReviews = [] } = reviewsData;
// Top reviews: highest rating first, newest first within the same rating
const reviews = [...allReviews]
  .sort((a, b) => b.rating - a.rating || (b.isoDate || "").localeCompare(a.isoDate || ""))
  .slice(0, maxReviews);

// Clones on both ends make the loop seamless (jump happens off-screen).
// Each slide keeps its original review index so expansion state can stay
// in sync between a real slide and its clones.
const CLONES = 2;
const indexed = reviews.map((r, idx) => ({ ...r, idx }));
const slides = [
  ...indexed.slice(-CLONES).map((r) => ({ ...r, clone: true })),
  ...indexed.map((r) => ({ ...r, clone: false })),
  ...indexed.slice(0, CLONES).map((r) => ({ ...r, clone: true })),
];
---

{reviews.length > 0 && (
  <section class="relative py-16 md:py-20 bg-light overflow-hidden">
    <div class="container px-4 sm:px-6 lg:px-8 mx-auto">
      <div class="max-w-[1240px] mx-auto">
        <!-- Header -->
        <div class="text-center mb-10 md:mb-14">
          {eyebrow && (
            <span class="inline-block px-5 py-2 rounded-full bg-[var(--brand-dark)] text-white text-xs md:text-sm font-bold uppercase tracking-wider mb-6">
              {eyebrow}
            </span>
          )}
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4 text-balance">
            {title}
          </h2>
          {description && (
            <p class="text-base md:text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto" set:html={description} />
          )}
        </div>
      </div>
    </div>

    <!-- Center-mode carousel -->
    <div id="reviews-carousel" class="relative max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
      <button
        id="reviews-prev"
        class="absolute left-2 lg:left-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 flex items-center justify-center rounded-full bg-white shadow-lg border border-gray-200 text-gray-700 hover:text-[var(--brand-secondary)] hover:shadow-xl transition-all"
        aria-label="Previous review"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <div class="overflow-hidden py-6" id="reviews-viewport">
        <div id="reviews-track" class="flex items-center gap-6 will-change-transform">
          {slides.map((review, i) => (
            <article
              class="review-card flex-shrink-0 w-[82%] sm:w-[46%] lg:w-[31%] bg-white rounded-2xl border border-gray-200 p-6 md:p-7 flex flex-col transition-all duration-500"
              data-slide-index={i}
              data-review-idx={review.idx}
              aria-hidden={review.clone ? "true" : undefined}
            >
              <div class="flex items-start justify-between mb-3">
                <div class="flex items-center gap-3 min-w-0">
                  <span class="relative flex-shrink-0 w-12 h-12 rounded-full overflow-hidden bg-[var(--brand-secondary)] text-white font-bold text-lg flex items-center justify-center">
                    <span aria-hidden="true">{review.author.charAt(0)}</span>
                    {review.avatar && (
                      <img
                        src={review.avatar}
                        alt=""
                        class="absolute inset-0 w-full h-full object-cover"
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                        onerror="this.remove()"
                      />
                    )}
                  </span>
                  <div class="min-w-0">
                    <p class="font-bold text-gray-900 text-base truncate">{review.author}</p>
                    <p class="text-xs text-gray-500">{review.date}</p>
                  </div>
                </div>
                <!-- Google G -->
                <svg class="w-7 h-7 flex-shrink-0 ml-3" viewBox="0 0 24 24" aria-label="Google review">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
              </div>

              <div class="flex items-center gap-1.5 mb-4">
                <span class="flex" aria-label={`${review.rating} out of 5 stars`}>
                  {Array.from({ length: 5 }).map((_, s) => (
                    <svg class={`w-5 h-5 ${s < review.rating ? "text-amber-400" : "text-gray-300"}`} fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.367 2.446a1 1 0 00-.363 1.118l1.286 3.958c.3.922-.755 1.688-1.539 1.118l-3.367-2.446a1 1 0 00-1.175 0l-3.367 2.446c-.783.57-1.838-.196-1.538-1.118l1.285-3.958a1 1 0 00-.362-1.118L2.05 9.385c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.3-3.958z"/>
                    </svg>
                  ))}
                </span>
                <!-- verified check -->
                <svg class="w-4 h-4 text-[#4285F4]" fill="currentColor" viewBox="0 0 20 20" aria-label="Verified review">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
              </div>

              <p class="review-text text-sm md:text-base text-gray-600 leading-relaxed line-clamp-6 flex-1">
                {review.text}
              </p>
              <button
                class="review-toggle self-start mt-3 text-sm font-semibold text-[var(--brand-secondary)] hover:underline"
                aria-expanded="false"
              >
                Read more
              </button>
            </article>
          ))}
        </div>
      </div>

      <button
        id="reviews-next"
        class="absolute right-2 lg:right-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 flex items-center justify-center rounded-full bg-white shadow-lg border border-gray-200 text-gray-700 hover:text-[var(--brand-secondary)] hover:shadow-xl transition-all"
        aria-label="Next review"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- CTA -->
    <div class="flex justify-center mt-8 md:mt-10">
      <a
        href={reviewsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-4 bg-[var(--brand-secondary)] hover:bg-black text-white font-bold rounded-lg transition-colors duration-300"
      >
        {ctaText}
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </section>
)}

<script>
  function initReviewsCarousel() {
    const viewportEl = document.getElementById("reviews-viewport");
    const trackEl = document.getElementById("reviews-track");
    if (!viewportEl || !trackEl || trackEl.dataset.initialized === "true") return;
    const viewport = viewportEl;
    const track = trackEl;
    track.dataset.initialized = "true";

    const cards = Array.from(track.querySelectorAll<HTMLElement>(".review-card"));
    const CLONES = 2;
    const realCount = cards.length - CLONES * 2;
    if (realCount < 1) return;

    let index = CLONES; // first real slide
    let timer: ReturnType<typeof setInterval> | null = null;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function center(animate = true) {
      const card = cards[index];
      if (!card) return;
      const tx = viewport.clientWidth / 2 - (card.offsetLeft + card.offsetWidth / 2);
      track.style.transition = animate ? "transform 600ms cubic-bezier(0.4, 0, 0.2, 1)" : "none";
      track.style.transform = `translateX(${tx}px)`;
      cards.forEach((c, i) => c.classList.toggle("is-active", i === index));
      collapseInactive();
    }

    // Any expanded review that is no longer the centered card folds back to
    // "Read more" - only the highlighted card keeps the taller, expanded state.
    function collapseInactive() {
      const activeReview = cards[index]?.dataset.reviewIdx;
      const expandedReviews = new Set(
        cards
          .filter((c) => c.querySelector(".review-toggle")?.getAttribute("aria-expanded") === "true")
          .map((c) => c.dataset.reviewIdx || "")
      );
      expandedReviews.forEach((idx) => {
        if (idx && idx !== activeReview) setExpanded(idx, false);
      });
    }

    function normalize() {
      // After sliding onto a clone, snap invisibly to the matching real slide
      if (index < CLONES) {
        index += realCount;
        center(false);
      } else if (index >= CLONES + realCount) {
        index -= realCount;
        center(false);
      }
    }

    function go(dir: number) {
      index += dir;
      center(true);
    }

    track.addEventListener("transitionend", normalize);

    document.getElementById("reviews-prev")?.addEventListener("click", () => { go(-1); restart(); });
    document.getElementById("reviews-next")?.addEventListener("click", () => { go(1); restart(); });

    function start() {
      if (reducedMotion || timer) return;
      timer = setInterval(() => go(1), 4500);
    }
    function stop() {
      if (timer) { clearInterval(timer); timer = null; }
    }
    function restart() { stop(); start(); }

    const carousel = document.getElementById("reviews-carousel");
    carousel?.addEventListener("mouseenter", stop);
    carousel?.addEventListener("mouseleave", start);
    carousel?.addEventListener("focusin", stop);
    carousel?.addEventListener("focusout", start);

    window.addEventListener("resize", () => center(false), { passive: true });

    // Read-more toggles.
    // Expansion is applied to every slide sharing the same review (real +
    // clones stay in sync), and only to that review - other cards keep
    // their own height since the track no longer stretches rows.
    function setExpanded(reviewIdx: string, expand: boolean) {
      cards
        .filter((c) => c.dataset.reviewIdx === reviewIdx)
        .forEach((c) => {
          const text = c.querySelector<HTMLElement>(".review-text");
          const btn = c.querySelector<HTMLButtonElement>(".review-toggle");
          if (!text || !btn) return;
          text.classList.toggle("line-clamp-6", !expand);
          btn.setAttribute("aria-expanded", String(expand));
          btn.textContent = expand ? "Read less" : "Read more";
        });
    }

    document.querySelectorAll<HTMLButtonElement>(".review-toggle").forEach((btn) => {
      const text = btn.previousElementSibling as HTMLElement | null;
      if (!text) return;
      if (text.scrollHeight <= text.clientHeight + 2) {
        btn.classList.add("hidden");
        return;
      }
      btn.addEventListener("click", () => {
        const card = btn.closest<HTMLElement>(".review-card");
        if (!card) return;
        const slideIdx = cards.indexOf(card);
        const expand = btn.getAttribute("aria-expanded") !== "true";

        // Side card: bring it to center first, then expand
        if (slideIdx !== index) {
          index = slideIdx;
          center(true);
          restart();
        }
        setExpanded(card.dataset.reviewIdx || "", expand);
      });
    });

    center(false);
    start();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initReviewsCarousel);
  } else {
    initReviewsCarousel();
  }
</script>

<style>
  /* Side cards: quiet, shorter. Active (centered) card: brand border,
     visibly taller, lifted with deeper shadow */
  .review-card {
    opacity: 0.65;
    transform: scale(0.94);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
    min-height: 300px;
  }

  .review-card.is-active {
    opacity: 1;
    transform: scale(1);
    border-color: var(--brand-secondary);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
    min-height: 380px;
  }

  @media (prefers-reduced-motion: reduce) {
    .review-card {
      transition: none;
    }
  }
</style>
