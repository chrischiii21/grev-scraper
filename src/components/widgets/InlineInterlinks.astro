---
interface Link {
  title: string;
  href: string;
  icon?: string;
}

interface Props {
  title?: string;
  description?: string;
  links: Link[];
  columns?: number;
}

const {
  title = "Explore More",
  description = "Discover other pages that might interest you",
  links = [],
  columns = 3,
} = Astro.props;

const gridCols = {
  2: "md:grid-cols-2",
  3: "md:grid-cols-3",
  4: "md:grid-cols-4",
};
---

<section class="py-12 md:py-16 bg-[var(--brand-dark)]">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">
        {title}
      </h2>
      <p class="text-gray-300 text-sm md:text-base" set:html={description} />
    </div>

    <div class={`grid grid-cols-1 sm:grid-cols-2 ${gridCols[columns]} gap-4`}>
      {links.map((link) => (
        <a
          href={link.href}
          class="group flex items-center gap-3 p-5 bg-white/10 rounded-lg border border-white/20 hover:border-[var(--brand-quaternary)] hover:bg-white/20 hover:shadow-lg transition-all duration-300"
        >
          <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[var(--brand-quaternary)] flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg
              class="w-6 h-6 text-[var(--brand-dark)]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"
              />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-base font-semibold text-white group-hover:text-[var(--brand-quaternary)] transition-colors">
              {link.title}
            </h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
