---
interface Card {
  title?: string;
  description?: string;
  icon?: string;
  image?: string;
}

interface Props {
  title?: string;
  eyebrow?: string;
  description?: string;
  cards: Card[];
  ctaText?: string;
  ctaLink?: string;
  image?: string;
  image2?: string;
  background?: string;
}

const {
  title,
  eyebrow,
  description,
  cards = [],
  ctaText,
  ctaLink,
  image,
  image2,
  background = "#f7fbfe",
} = Astro.props;

// Default global images
const defaultMainImage = "/images/digital-marketing.avif";
const defaultSecondImage = "/images/features-image.jpeg";

// Use provided images only (no fallback to card images or defaults)
const mainImage = image || defaultMainImage;
const secondImage = image2; // Only use if explicitly provided
---

<section class="py-12 md:py-16 lg:py-20" style={`background-color: ${background};`}>
  <div class="container px-4 sm:px-6 lg:px-8 mx-auto">
    <div class="max-w-[1240px] mx-auto">
      {/* Two Column Layout: Images Left, Features Right */}
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        {/* Left: Blue Heading + Title + Two Overlapping Images */}
        <div class="order-2 lg:order-1">
          {/* Blue Heading */}
          <p class="flex items-center gap-2 text-[var(--brand-secondary)] text-sm md:text-base font-bold uppercase tracking-wider mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor">
              <rect width="16" height="16" rx="2"/>
            </svg>
            WHY CHOOSE US?
          </p>

          {/* Title */}
          {title && (
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-10 lg:mb-12 leading-tight">
              {title}
            </h2>
          )}

          {/* Description */}
          {description && (
            <p class="text-base md:text-lg text-gray-700 leading-relaxed mb-10 lg:mb-12" set:html={description} />
          )}

          {/* Two Overlapping Images */}
          <div class="relative pb-16 lg:pb-20 mt-16 lg:mt-20">
            {secondImage && (
              <div class="absolute top-0 left-0 w-3/5 -translate-y-8 -translate-x-8 lg:-translate-y-12 lg:-translate-x-12 rounded-2xl overflow-hidden shadow-2xl border-4 border-white z-10">
                <img 
                  src={secondImage} 
                  alt="Secondary image" 
                  class="w-full h-auto object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            {mainImage && (
              <div class="relative rounded-2xl overflow-hidden shadow-2xl">
                <img 
                  src={mainImage} 
                  alt={title || "Features image"} 
                  class="w-full h-auto object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
          </div>
        </div>

        {/* Right: Numbered Features List */}
        <div class="order-1 lg:order-2 lg:mt-16 flex flex-col justify-center">
          {/* Features List */}
          <div class="space-y-6">
            {cards.map((card, index) => (
              <div class="flex gap-4 items-start">
                {/* Number Badge - Simple Circle with Dashed Border */}
                <div class="flex-shrink-0 w-16 h-16 rounded-full flex items-center justify-center relative text-[var(--brand-secondary)]">
                  <svg class="absolute inset-0 w-full h-full" viewBox="0 0 64 64">
                    {/* Dashed circle border */}
                    <circle
                      cx="32"
                      cy="32"
                      r="26"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-dasharray="3 3"
                      stroke-linecap="round"
                    />
                  </svg>
                  <span class="text-[var(--brand-secondary)] font-bold text-2xl relative z-10">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                </div>
                
                {/* Content */}
                <div class="flex-1">
                  {card.title && (
                    <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-2" set:html={card.title} />
                  )}
                  {card.description && (
                    <p class="text-base md:text-lg text-gray-700 leading-relaxed" set:html={card.description} />
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* CTA Button */}
      {ctaText && ctaLink && (
        <div class="mt-10 lg:mt-12">
          <a 
            href={ctaLink} 
            class="inline-flex items-center gap-2 px-8 py-3 bg-[var(--brand-secondary)] hover:bg-black text-white font-bold rounded-lg transition-colors duration-300"
          >
            {ctaText}
          </a>
        </div>
      )}
    </div>
  </div>
</section>
