---
interface Props {
  title?: string;
  blueHeading?: string;
  eyebrow?: string;
  description?: string;
  additionalText?: string;
  ctaText?: string;
  ctaLink?: string;
  image?: string;
  keyPoints?: string[];
}

const {
  title,
  blueHeading,
  eyebrow,
  description,
  additionalText,
  ctaText,
  ctaLink,
  image,
  keyPoints = [],
} = Astro.props;
---

<section class="relative py-12 md:py-16 lg:py-20 bg-white">
  <div class="container px-4 sm:px-6 lg:px-8 mx-auto">
    <div class="max-w-[1240px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <!-- Left: Image -->
        <div class="hidden md:block order-2 lg:order-1">
          {image && (
            <div class="rounded-2xl overflow-hidden shadow-lg">
              <img 
                src={image} 
                alt={title || "Content image"} 
                width="900"
                height="618"
                class="w-full h-auto object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
        </div>
        
        <!-- Right: Content -->
        <div class="order-1 lg:order-2">
          {eyebrow && (
            <p class="flex items-center gap-2 text-[var(--brand-secondary)] text-sm md:text-base font-bold uppercase tracking-wider mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor">
                <rect width="16" height="16" rx="2"/>
              </svg>
              {eyebrow}
            </p>
          )}
          
          {blueHeading && (
            <p class="flex items-center gap-2 text-[var(--brand-secondary)] text-sm md:text-base font-bold uppercase tracking-wider mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor">
                <rect width="16" height="16" rx="2"/>
              </svg>
              {blueHeading}
            </p>
          )}
          
          {title && (
            <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-5 leading-tight">
              {title}
            </h2>
          )}
          
          {description && (
            <p class="text-base md:text-lg text-gray-700 leading-relaxed mb-4" set:html={description} />
          )}
          
          {keyPoints.length > 0 && (
            <ul class="space-y-3 mb-6">
              {keyPoints.map((point) => (
                <li class="flex items-start">
                  <svg
                    class="w-5 h-5 text-[var(--brand-secondary)] mr-3 flex-shrink-0 mt-0.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  <span class="text-gray-700">{point}</span>
                </li>
              ))}
            </ul>
          )}
          
          {additionalText && (
            <p class="text-sm md:text-base text-gray-700 leading-relaxed mb-6">
              {additionalText}
            </p>
          )}
          
          {ctaText && ctaLink && (
            <a 
              href={ctaLink} 
              class="inline-flex items-center gap-2 px-8 py-3 bg-[var(--brand-secondary)] hover:bg-[var(--brand-quaternary)] text-white font-semibold rounded-lg transition-colors duration-300"
            >
              {ctaText}
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
