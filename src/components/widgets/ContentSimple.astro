---
interface Props {
  title?: string;
  eyebrow?: string;
  description?: string;
  ctaText?: string;
  ctaLink?: string;
  image?: string;
  background?: string;
  centered?: boolean;
}

const {
  title,
  eyebrow,
  description,
  ctaText,
  ctaLink,
  image,
  background,
  centered = false,
} = Astro.props;

// Determine background color and text color
let bgClass = "bg-white";
let bgStyle = "";
let isDark = false;

if (background) {
  if (background.includes("#")) {
    bgStyle = `background-color: ${background}`;
    bgClass = "";
    // Check if it's a dark background
    isDark = background === "#0e1247" || background === "#0D1445" || background.toLowerCase().includes("dark");
  } else if (background.includes("bg-")) {
    bgClass = background;
    isDark = background.includes("dark") || background.includes("gray-900") || background.includes("black");
  }
}

// Set text colors based on background
const titleColor = isDark ? "text-white" : "text-gray-900";
const textColor = isDark ? "text-white/90" : "text-gray-600";
const eyebrowBg = isDark ? "bg-white/10" : "bg-blue-50";
const eyebrowText = isDark ? "text-white" : "text-blue-700";
---

<section class={`relative py-16 md:py-20 lg:py-24 ${bgClass}`} style={bgStyle}>
  <div class="container mx-auto px-4">
    <div class="max-w-[1240px] mx-auto">
      {image ? (
        <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 xl:gap-16 items-center">
          <!-- Content Side -->
          <div class="w-full lg:w-1/2">
            {eyebrow && (
              <div class="mb-4">
                <span class={`inline-block px-4 py-1.5 ${eyebrowBg} ${eyebrowText} text-xs font-semibold uppercase tracking-wider rounded-full`}>
                  {eyebrow}
                </span>
              </div>
            )}
            
            {title && (
              <h2 class={`text-3xl sm:text-4xl lg:text-5xl font-bold ${titleColor} leading-tight mb-6`}>
                {title}
              </h2>
            )}
            
            {description && (
              <div class={`prose prose-lg max-w-none ${textColor} leading-relaxed mb-8`} set:html={description} />
            )}
            
            {ctaText && ctaLink && (
              <div class="mt-8">
                <a 
                  href={ctaLink}
                  class="group inline-flex items-center gap-3 py-3.5 px-8 text-base font-bold text-white bg-[var(--brand-dark)] rounded-full transition-all duration-300 hover:bg-[var(--brand-dark)] hover:shadow-lg hover:scale-105"
                >
                  <span>{ctaText}</span>
                  <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            )}
          </div>
          
          <!-- Image Side -->
          <div class="w-full lg:w-1/2">
            <div class="relative rounded-2xl overflow-hidden shadow-2xl">
              <img 
                src={image} 
                alt={title || "Content image"} 
                class="w-full h-[400px] md:h-[500px] lg:h-[600px] object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
      ) : (
        <div class={`max-w-4xl ${centered ? 'mx-auto text-center' : ''}`}>
          {eyebrow && (
            <div class={`mb-4 ${centered ? 'flex justify-center' : ''}`}>
              <span class={`inline-block px-4 py-1.5 ${eyebrowBg} ${eyebrowText} text-xs font-semibold uppercase tracking-wider rounded-full`}>
                {eyebrow}
              </span>
            </div>
          )}
          
          {title && (
            <h2 class={`text-3xl sm:text-4xl lg:text-5xl font-bold ${titleColor} leading-tight mb-6`}>
              {title}
            </h2>
          )}
          
          {description && (
            <div class={`prose prose-lg max-w-none ${textColor} leading-relaxed mb-8`} set:html={description} />
          )}
          
          {ctaText && ctaLink && (
            <div class="mt-8">
              <a 
                href={ctaLink}
                class="group inline-flex items-center gap-3 py-3.5 px-8 text-base font-bold text-white bg-[var(--brand-dark)] rounded-full transition-all duration-300 hover:bg-[var(--brand-dark)] hover:shadow-lg hover:scale-105"
              >
                <span>{ctaText}</span>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          )}
        </div>
      )}
    </div>
  </div>
</section>
