---
interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  features?: any[];
  ctaText?: string;
  ctaLink?: string;
  background?: string;
}

const {
  eyebrow,
  title,
  description,
  features = [],
  ctaText,
  ctaLink,
  background = "#ffffff",
} = Astro.props;

// Determine background color
let bgClass = "bg-white";
let bgStyle = "";
if (background) {
  if (background.includes("#")) {
    bgStyle = `background-color: ${background}`;
    bgClass = "";
  } else if (background.includes("bg-")) {
    bgClass = background;
  }
}
---

<section class={`relative py-12 md:py-16 ${bgClass}`} style={bgStyle}>
  <div class="container mx-auto px-4">
    <div class="max-w-[1240px] mx-auto">
      <!-- Header -->
      <div class="mb-10 md:mb-12">
        {eyebrow && (
          <p class="flex items-center gap-2 text-[var(--brand-secondary)] text-sm md:text-base font-bold uppercase tracking-wider mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor">
              <rect width="16" height="16" rx="2"/>
            </svg>
            {eyebrow}
          </p>
        )}
        {title && (
          <h2 class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 leading-tight mb-4">
            {title}
          </h2>
        )}
        {description && (
          <p class="text-base md:text-lg text-gray-600 max-w-4xl leading-relaxed" set:html={description} />
        )}
      </div>

      <!-- Features Grid - 2x2 or flexible layout -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
        {features.map((feature, index) => {
          let spanClass = '';
          
          // Make the 5th card (index 4) span full width for 5-item layouts
          if (features.length === 5 && index === 4) {
            spanClass = 'sm:col-span-2';
          }
          
          return (
            <div 
              class={`group bg-white border border-[#f7f7f7] ${spanClass} rounded-lg shadow-sm hover:shadow-md transition-all duration-300 p-6 flex flex-col`}
            >
              {/* Icon */}
              {feature.icon && (
                <div class="mb-4">
                  <svg class="w-12 h-12 text-[var(--brand-secondary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    {/* Location & Navigation */}
                    {feature.icon === 'tabler:map-pin' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    )}
                    
                    {/* Media & Play */}
                    {feature.icon === 'tabler:player-play' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    )}
                    
                    {/* Rating & Favorites */}
                    {feature.icon === 'tabler:star' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                    )}
                    
                    {/* Refresh & Update */}
                    {feature.icon === 'tabler:refresh' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    )}
                    
                    {/* Arrows & Direction */}
                    {feature.icon === 'tabler:arrows-left-right' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                    )}
                    
                    {/* Web & World */}
                    {feature.icon === 'tabler:world' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                    )}
                    
                    {/* Search */}
                    {feature.icon === 'tabler:search' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    )}
                    
                    {/* Users & People */}
                    {feature.icon === 'tabler:users' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    )}
                    
                    {/* Code & Development */}
                    {feature.icon === 'tabler:code' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                    )}
                    
                    {/* Sparkles & Magic */}
                    {feature.icon === 'tabler:sparkles' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                    )}
                    
                    {/* Calendar */}
                    {feature.icon === 'tabler:calendar-event' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    )}
                    
                    {/* User Check */}
                    {feature.icon === 'tabler:user-check' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    )}
                    
                    {/* Report Analytics */}
                    {feature.icon === 'tabler:report-analytics' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    )}
                    
                    {/* Settings */}
                    {feature.icon === 'tabler:settings' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    )}
                    
                    {/* Palette */}
                    {feature.icon === 'tabler:palette' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                    )}
                    
                    {/* Bulb / Idea */}
                    {feature.icon === 'tabler:bulb' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                    )}
                    
                    {/* Briefcase */}
                    {feature.icon === 'tabler:briefcase' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    )}
                    
                    {/* Trophy */}
                    {feature.icon === 'tabler:trophy' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                    )}
                    
                    {/* Target */}
                    {feature.icon === 'tabler:target' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 0v20m10-10H2" />
                    )}
                    
                    {/* Currency Dollar */}
                    {feature.icon === 'tabler:currency-dollar' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    )}
                  </svg>
                </div>
              )}
              
              <div class="flex-1">
                {/* Title */}
                <h3 class="text-gray-900 text-lg md:text-xl font-bold mb-3">
                  {feature.title}
                </h3>
                
                {/* Description */}
                <p class="text-gray-700 text-sm sm:text-base leading-relaxed" set:html={feature.description} />
              </div>
            </div>
          );
        })}
      </div>

      <!-- CTA -->
      {ctaText && ctaLink && (
        <div class="text-center mt-12">
          <a
            href={ctaLink}
            class="inline-flex items-center gap-3 px-8 py-4 bg-[var(--brand-dark)] text-white font-bold rounded-full hover:bg-[var(--brand-dark)] transition-all duration-300 hover:shadow-lg hover:scale-105"
          >
            <span>{ctaText}</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      )}
    </div>
  </div>
</section>
