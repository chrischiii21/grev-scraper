---
interface Props {
  title?: string;
  blueHeading?: string;
  eyebrow?: string;
  description?: string;
  ctaText?: string;
  ctaLink?: string;
  videoUrl: string; // Direct video URL (required)
  videoPosition?: "left" | "right";
  background?: string;
  poster?: string; // Optional poster/thumbnail
  autoplay?: boolean;
  muted?: boolean;
  loop?: boolean;
  controls?: boolean;
}

const {
  title,
  blueHeading,
  eyebrow,
  description,
  ctaText,
  ctaLink,
  videoUrl,
  videoPosition = "right",
  background = "white",
  poster,
  autoplay = false,
  muted = false,
  loop = false,
  controls = true,
} = Astro.props;
---

<section class="relative py-12 md:py-16 lg:py-20" style={background.startsWith('#') ? `background-color: ${background};` : `background-color: ${background};`}>
  <div class="container px-4 sm:px-6 lg:px-8 mx-auto">
    <div class="max-w-[1240px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <!-- Content -->
        <div class={videoPosition === "left" ? "order-2 lg:order-2" : "order-1 lg:order-1"}>
          {blueHeading && (
            <p class="flex items-center gap-2 text-[var(--brand-secondary)] text-sm md:text-base font-bold uppercase tracking-wider mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor">
                <rect width="16" height="16" rx="2"/>
              </svg>
              {blueHeading}
            </p>
          )}
          
          {eyebrow && (
            <p class="flex items-center gap-2 text-[var(--brand-secondary)] text-sm md:text-base font-bold uppercase tracking-wider mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor">
                <rect width="16" height="16" rx="2"/>
              </svg>
              {eyebrow}
            </p>
          )}
          
          {title && (
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-5 leading-tight">
              {title}
            </h2>
          )}
          
          {description && (
            <p class="text-base md:text-lg text-gray-700 leading-relaxed mb-6" set:html={description} />
          )}
          
          {ctaText && ctaLink && (
            <a 
              href={ctaLink} 
              class="inline-flex items-center gap-2 px-8 py-3 bg-[var(--brand-secondary)] hover:bg-black text-white font-bold rounded-lg transition-colors duration-300"
            >
              {ctaText}
            </a>
          )}
        </div>
        
        <!-- Video -->
        <div class={videoPosition === "left" ? "order-1 lg:order-1" : "order-2 lg:order-2"}>
          <div class="rounded-2xl overflow-hidden shadow-lg">
            <video
              src={videoUrl}
              class="w-full h-auto aspect-video bg-black"
              controls={controls}
              playsinline
              preload="metadata"
              autoplay={autoplay}
              muted={muted}
              loop={loop}
              poster={poster}
            >
              Your browser does not support the video tag.
            </video>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
