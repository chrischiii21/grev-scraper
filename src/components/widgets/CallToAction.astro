---
interface Props {
  title?: string;
  subtitle?: string;
  actions?: Array<{
    text: string;
    href: string;
    variant?: 'primary' | 'secondary';
  }>;
}

const {
  title = 'Ready to get started?',
  subtitle = 'Contact us today to learn how we can help grow your business.',
  actions = [
    { text: 'Get In Touch', href: '/contact', variant: 'primary' },
  ],
} = Astro.props;
---

<section class="relative py-12 md:py-14 bg-white">
  <div class="container px-4 sm:px-6 lg:px-8 mx-auto">
    <div class="max-w-[1240px] mx-auto bg-[var(--brand-dark)] px-8 py-10 md:px-12 md:py-12 text-center rounded-2xl">
      <!-- Heading -->
      {title && (
        <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-white font-bold leading-tight mb-4">
          {title}
        </h2>
      )}
      
      <!-- Subtext -->
      {subtitle && (
        <p class="max-w-3xl mx-auto text-base md:text-lg leading-relaxed mb-8 text-white/95" set:html={subtitle}></p>
      )}
      
      <!-- CTA Button -->
      {actions.length > 0 && (
        <div class="flex justify-center">
          {actions.map((action) => (
            <a
              href={action.href}
              target={/^https?:\/\//.test(action.href) ? "_blank" : undefined}
              rel={/^https?:\/\//.test(action.href) ? "noopener noreferrer" : undefined}
              class="inline-flex items-center gap-2 px-8 py-4 bg-white hover:bg-secondary text-primary hover:text-white font-bold rounded-lg transition-colors duration-300 shadow-lg"
            >
              {action.text}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
